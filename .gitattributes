# Set default behavior to automatically normalize line endings
* text=auto

# Force LF for common text files (useful for cross-platform consistency)
*.cs     text eol=lf
*.cshtml text eol=lf
*.html  text eol=lf
*.css   text eol=lf
*.scss  text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.xml   text eol=lf
*.md    text eol=lf

# Treat image and binary files as binary
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary

# Node / npm lockfiles
package-lock.json  text eol=lf
yarn.lock          text eol=lf

# Ignore Visual Studio temporary files (optional safekeep)
.vs/    export-ignore
