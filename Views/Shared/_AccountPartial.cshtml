@using Microsoft.AspNetCore.Identity;
@using EasyRepair.Models;
@inject SignInManager<ApplicationUser> SignInManager;

<style>
    ul{
        list-style: none;
    }
</style>

<ul class="d-flex ms-auto">
    @if (SignInManager.IsSignedIn(User))
    {
        <li>
            <form asp-controller="Account" asp-action="Logout" style="dispaly:inline">
                <button type="submit" style="border: none; padding: 0.5rem 0.5rem; background: transparent" class="nav-link">Logout</button>
            </form>
        </li>
    }
    else
    {
        <li><a asp-controller="Account" asp-action="Login" class="nav-link">Login</a></li>
        <li><a asp-controller="Account" asp-action="Registration" class="nav-link">Register</a></li>
    }
</ul>